{
  "name": "make-bookmarklet",
  "version": "2.1.1",
  "description": "A Node program to convert small JavaScript files to bookmarklet-ready code.",
  "type": "module",
  "main": "src/make-bookmarklet.js",
  "bin": {
    "make-bookmarklet": "src/make-bookmarklet.js",
    "unmake-bookmarklet": "src/unmake-bookmarklet.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "semistandard",
    "lint:fix": "semistandard --fix",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint --fix .",
    "test": "vitest",
    "release:dry-run": "npm run release:dry-run:main",
    "release:dry-run:main": "sh ./scripts/release-dry-run-main.sh",
    "release:dry-run:feature": "sh ./scripts/release-dry-run-feature.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinashworth/make-bookmarklet.git"
  },
  "keywords": [
    "bookmarklet",
    "JavaScript",
    "Node"
  ],
  "author": "Kevin Ashworth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kevinashworth/make-bookmarklet/issues"
  },
  "homepage": "https://github.com/kevinashworth/make-bookmarklet#readme",
  "dependencies": {
    "chalk": "5.6.2",
    "clipboardy": "5.3.1",
    "commander": "14.0.3",
    "prettier": "3.8.3"
  },
  "devDependencies": {
    "execa": "9.6.1",
    "markdownlint-cli": "0.48.0",
    "semistandard": "17.0.0",
    "vitest": "4.1.7"
  },
  "semistandard": {
    "globals": [
      "$",
      "describe",
      "expect",
      "fit",
      "it",
      "test",
      "xit"
    ],
    "ignore": [
      "/examples/archive/",
      "/examples/bookmarklets/",
      "/examples/**/*output*.js",
      "/examples/shortwave/sw.js",
      "/test_inputs/",
      "/src/__tests__/__fixtures__/"
    ]
  }
}
